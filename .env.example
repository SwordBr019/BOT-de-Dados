# Copie este arquivo para .env somente se quiser alterar as configurações.

# Pasta onde a sessão vinculada será salva.
AUTH_DIR=auth

# true = responde em privado e em grupos | false = responde apenas no privado
ALLOW_GROUPS=true

# Marca os comandos recebidos como lidos.
MARK_AS_READ=true

# Nível do log interno do Baileys: silent, error, warn, info, debug ou trace
LOG_LEVEL=silent
